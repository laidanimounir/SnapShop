# ============================================================
# SnapShop — Storefront Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# All NEXT_PUBLIC_* vars are exposed to the browser.
# Never commit .env.local or real secrets.

# Brand identity (placeholders — replace with your own)
NEXT_PUBLIC_BRAND_NAME=SnapShop
NEXT_PUBLIC_TAGLINE="SnapShop - Modern E-Commerce"
NEXT_PUBLIC_OWNER_NAME="Store Owner"

# Contact information (placeholders — replace with your own)
NEXT_PUBLIC_CONTACT_PHONE=+1000000000
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com

# Social (placeholder — replace with your own)
NEXT_PUBLIC_GITHUB_URL=https://github.com/example

# Brand colors (hex values)
NEXT_PUBLIC_PRIMARY_COLOR=#1A1A1A
NEXT_PUBLIC_ACCENT_COLOR=#C9A24B

# Supabase (project fvvretvbeiovjozpqbyk)
NEXT_PUBLIC_SUPABASE_URL=https://fvvretvbeiovjozpqbyk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
