# ============================================================
# SnapShop — Storefront Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# All NEXT_PUBLIC_* vars are exposed to the browser.

# Brand identity
NEXT_PUBLIC_BRAND_NAME=SnapShop
NEXT_PUBLIC_TAGLINE="SnapShop - Modern E-Commerce"
NEXT_PUBLIC_OWNER_NAME="LAIDANI Mounir"

# Contact information
NEXT_PUBLIC_CONTACT_PHONE=+213776171171
NEXT_PUBLIC_CONTACT_EMAIL=laidanimounir606@gmail.com

# Social
NEXT_PUBLIC_GITHUB_URL=https://github.com/laidanimounir

# Brand colors (hex values)
NEXT_PUBLIC_PRIMARY_COLOR=#1A1A1A
NEXT_PUBLIC_ACCENT_COLOR=#C9A24B

# Supabase (set these when you connect your backend)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
